# Variáveis do Vercel (Project Settings > Environment Variables). Nunca commitar valores reais.
NEKT_API_KEY=
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# opcional (padrão fourlabnutri_trusted)
# NEKT_DATABASE=fourlabnutri_trusted

# Gestão de atletas (projeto Supabase dos atletas)
ATLETAS_URL=https://xxxxxxxxxxxx.supabase.co
ATLETAS_SERVICE_KEY=

SUPABASE_SERVICE_KEY=

# Fechamento mensal de pagamentos a atletas (cron do Vercel)
CRON_SECRET=
